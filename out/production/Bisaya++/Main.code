SUGOD
    MUGNA NUMERO edad
    DAWAT: edad
    KUNG (edad >= 18)
    PUNDOK{
        IPAKITA: "Adult"
    }
    KUNG DILI (edad >= 13)
    PUNDOK{
        IPAKITA: "Teen"
    }
    KUNG DILI (edad >= 6)
    PUNDOK{
        IPAKITA: "Child"
    }
    KUNG WALA
    PUNDOK{
        IPAKITA: "Toddler"
    }
KATAPUSAN